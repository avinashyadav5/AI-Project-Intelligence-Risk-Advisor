# Copy to server/.env and ai-service/.env as appropriate.

# ── Express server ────────────────────────────────────────────────────────────
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riskadvisor?schema=public
JWT_SECRET=replace_with_a_long_random_string
AI_SERVICE_URL=http://127.0.0.1:8000
CLIENT_URL=http://localhost:5173

# ── AI microservice ───────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Client (build-time) ───────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
